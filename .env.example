GROQ_API_KEY=your-free-groq-api-key-here
CAREFLOW_MODEL=openai/gpt-oss-20b

# Database (defaults assume `docker compose up -d db`, which maps container 5432 to host 5433
# -- 5432 itself is reserved on dev machines that already run a local/other-project Postgres)
DATABASE_URL=postgresql://careflow:careflow@localhost:5433/careflow

# development | production. In production, JWT_SECRET below becomes required (no auto-generated
# fallback), so sessions don't silently invalidate or depend on an insecure default.
CAREFLOW_ENV=development

# Required when CAREFLOW_ENV=production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Comma-separated list of origins allowed to call the API cross-origin. Leave empty if the
# frontend is served from the same origin as the API (the default setup) -- same-origin
# requests aren't subject to CORS at all. Example: https://careflow.yourhospital.org
ALLOWED_ORIGINS=

# Rate limits (slowapi syntax, e.g. "10/minute", "100/hour")
LOGIN_RATE_LIMIT=10/minute
API_RATE_LIMIT=120/minute
